properties([])

def SYNC_CHANGES = false
def OPEN_PR_FOUND = false
def PULL_REQUEST_URL = ''

pipeline {
    agent { label 'SAG-PREP-IPP02' }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
        skipDefaultCheckout(true)
    }

    environment {
        ENVIRONMENT_NAME = 'DEV'

        SOURCE_SERVER = 'PREPROD_APP02'
        SOURCE_HOST = '10.7.248.75'

        SERVER_SSH_USER = 'apiadmin'
        SERVER_PACKAGE_ROOT = '/sag/dbp1011/IntegrationServer/instances/default/packages'

        TARGET_BRANCH = 'DEV_CICD'
        SYNC_BRANCH = 'server-sync/DEV'

        BITBUCKET_URL = 'https://bitbucket.tawn.com'
        BITBUCKET_PROJECT = 'EI'
        BITBUCKET_REPOSITORY = 'webmethods-source-code'
        GIT_REMOTE = 'webmethods-source-code'

        SYNC_DIRECTORY = "${WORKSPACE}/.server_sync"
    }

    stages {
        stage('Set Build Information') {
            steps {
                script {
                    currentBuild.displayName = "DEV-SYNC-${env.BUILD_NUMBER}"
                    currentBuild.description =
                        "SOURCE=${env.SOURCE_SERVER} | TARGET=${env.TARGET_BRANCH}"

                    echo "Environment: ${env.ENVIRONMENT_NAME}"
                    echo "Execution agent: ${env.NODE_NAME}"
                    echo "Source server: ${env.SOURCE_SERVER}"
                    echo "Source host: ${env.SOURCE_HOST}"
                    echo "Target branch: ${env.TARGET_BRANCH}"
                    echo "Sync branch: ${env.SYNC_BRANCH}"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                deleteDir()

                bbs_checkout(
                    branches: [[name: "*/${env.TARGET_BRANCH}"]],
                    credentialsId: 'Admin_Bitbucket',
                    id: '06c55797-80ad-4cb9-bea7-299d2a91506e',
                    projectName: 'EI',
                    repositoryName: 'webmethods-source-code',
                    serverId: '2492752c-5622-4c29-9972-c1c0f572b1f6'
                )
            }
        }

        stage('Resolve Packages') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'IS_Server_SSH',
                            usernameVariable: 'SSH_USER',
                            passwordVariable: 'SSH_PASSWORD'
                        )
                    ]) {
                        def output = sshCommand(
                            remote: getRemoteServer(),
                            command: """
                                set -e

                                test -d '${env.SERVER_PACKAGE_ROOT}'

                                find '${env.SERVER_PACKAGE_ROOT}' \
                                    -mindepth 1 \
                                    -maxdepth 1 \
                                    -type d \
                                    ! -name 'Wm*' \
                                    ! -name 'Wx*' \
                                    ! -name 'Test*' \
                                    ! -name 'Sample*' \
                                    ! -name 'Default' \
                                    ! -name 'MSTest' \
                                    ! -name 'TerracottaExamples' \
                                    -printf '%f\\n' |
                                sort
                            """.stripIndent().trim()
                        )

                        def packages = output
                            .readLines()
                            .collect { it.trim() }
                            .findAll { it }

                        if (packages.isEmpty()) {
                            error(
                                "No business packages found on " +
                                "${env.SOURCE_SERVER}"
                            )
                        }

                        writeFile(
                            file: 'packages-to-sync.txt',
                            text: packages.join('\n') + '\n',
                            encoding: 'UTF-8'
                        )

                        echo "Packages found: ${packages.size()}"
                        echo "Packages: ${packages.join(', ')}"
                    }
                }
            }
        }

        stage('Synchronize Packages') {
            steps {
                script {
                    def packages = readPackageFile()
                    def packageArguments =
                        packages.collect { "'${it}'" }.join(' ')

                    def remoteArchive =
                        "/tmp/jenkins-dev-sync-${env.BUILD_NUMBER}.tar.gz"

                    def localArchive =
                        "${env.SYNC_DIRECTORY}/packages.tar.gz"

                    sh '''
                        set -e

                        if [ -z "${SYNC_DIRECTORY}" ]; then
                            echo "ERROR: SYNC_DIRECTORY is empty"
                            exit 1
                        fi

                        rm -rf "${SYNC_DIRECTORY}"
                        mkdir -p "${SYNC_DIRECTORY}"
                    '''

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'IS_Server_SSH',
                            usernameVariable: 'SSH_USER',
                            passwordVariable: 'SSH_PASSWORD'
                        )
                    ]) {
                        def remote = getRemoteServer()

                        try {
                            sshCommand(
                                remote: remote,
                                command: """
                                    set -e

                                    rm -f '${remoteArchive}'

                                    tar \
                                        -C '${env.SERVER_PACKAGE_ROOT}' \
                                        --exclude='*.log' \
                                        --exclude='*.tmp' \
                                        --exclude='*.lck' \
                                        --exclude='*.lock' \
                                        --exclude='*.bak' \
                                        --exclude='*/logs/*' \
                                        --exclude='*/log/*' \
                                        --exclude='*/cache/*' \
                                        --exclude='*/temp/*' \
                                        --exclude='*/tmp/*' \
                                        --exclude='*/stats/*' \
                                        --exclude='*/audit/*' \
                                        -czf '${remoteArchive}' \
                                        ${packageArguments}

                                    test -s '${remoteArchive}'
                                """.stripIndent().trim()
                            )

                            sshGet(
                                remote: remote,
                                from: remoteArchive,
                                into: localArchive,
                                override: true
                            )
                        } finally {
                            sshCommand(
                                remote: remote,
                                command: "rm -f '${remoteArchive}'",
                                failOnError: false
                            )
                        }
                    }

                    sh '''
                        set -e

                        test -f "${SYNC_DIRECTORY}/packages.tar.gz"

                        tar -xzf \
                            "${SYNC_DIRECTORY}/packages.tar.gz" \
                            -C "${SYNC_DIRECTORY}"

                        while IFS= read -r PACKAGE_NAME; do
                            [ -n "${PACKAGE_NAME}" ] || continue

                            SOURCE_PATH="${SYNC_DIRECTORY}/${PACKAGE_NAME}"
                            TARGET_PATH="${WORKSPACE}/IS/${PACKAGE_NAME}"

                            if [ ! -d "${SOURCE_PATH}" ]; then
                                echo "ERROR: Package not extracted: ${PACKAGE_NAME}"
                                exit 1
                            fi

                            rm -rf "${TARGET_PATH}"
                            mkdir -p "${TARGET_PATH}"

                            cp -a \
                                "${SOURCE_PATH}/." \
                                "${TARGET_PATH}/"
                        done < packages-to-sync.txt

                        rm -f "${SYNC_DIRECTORY}/packages.tar.gz"
                    '''
                }
            }
        }

        stage('Remove Runtime Files') {
    steps {
        sh '''
            set -e

            while IFS= read -r PACKAGE_NAME; do
                [ -n "${PACKAGE_NAME}" ] || continue

                PACKAGE_PATH="${WORKSPACE}/IS/${PACKAGE_NAME}"

                find "${PACKAGE_PATH}" -type f \
                    -name '*.log' -delete

                find "${PACKAGE_PATH}" -type f \
                    -name '*.tmp' -delete

                find "${PACKAGE_PATH}" -type f \
                    -name '*.lck' -delete

                find "${PACKAGE_PATH}" -type f \
                    -name '*.lock' -delete

                find "${PACKAGE_PATH}" -type f \
                    -name '*.bak' -delete

                for RUNTIME_DIR in \
                    logs log cache temp tmp stats audit
                do
                    find "${PACKAGE_PATH}" \
                        -type d \
                        -name "${RUNTIME_DIR}" \
                        -prune \
                        -exec rm -rf {} +
                done

            done < packages-to-sync.txt
        '''
    }
}

        stage('Detect Changes') {
            steps {
                script {
                    def status = sh(
                        script: '''
                            git status --porcelain -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**'
                        ''',
                        returnStdout: true
                    ).trim()

                    SYNC_CHANGES = status ? true : false

                    if (SYNC_CHANGES) {
                        echo 'Business package differences detected.'

                        sh '''
                            git status --short -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**'

                            git diff --stat -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**'
                        '''
                    } else {
                        echo 'No business package differences detected.'
                    }
                }
            }
        }

        stage('Commit And Push') {
            when {
                expression {
                    SYNC_CHANGES
                }
            }

            steps {
                sh '''
                    set -e

                    git config user.name "Jenkins webMethods Sync"
                    git config user.email "jenkins@tawuniya.com"

                    git checkout -B "${SYNC_BRANCH}"

                    git add -A -- IS \
                        ':(exclude)IS/Wm*/**' \
                        ':(exclude)IS/Wx*/**' \
                        ':(exclude)IS/Test*/**' \
                        ':(exclude)IS/Sample*/**' \
                        ':(exclude)IS/Default/**' \
                        ':(exclude)IS/MSTest/**' \
                        ':(exclude)IS/TerracottaExamples/**'

                    if git diff --cached --quiet; then
                        echo "ERROR: No staged business-package changes found"
                        exit 1
                    fi

                    git commit -m "Daily DEV server synchronization"
                '''

                withCredentials([
                    gitUsernamePassword(
                        credentialsId: 'Admin_Bitbucket',
                        gitToolName: 'Default'
                    )
                ]) {
                    sh '''
                        git push \
                            --force \
                            "${GIT_REMOTE}" \
                            "HEAD:refs/heads/${SYNC_BRANCH}"
                    '''
                }
            }
        }

        stage('Check Existing PR') {
            when {
                expression {
                    SYNC_CHANGES
                }
            }

            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'Admin_Bitbucket',
                            usernameVariable: 'BITBUCKET_USER',
                            passwordVariable: 'BITBUCKET_PWD'
                        )
                    ]) {
                        sh '''
                            curl \
                                --fail \
                                --silent \
                                --show-error \
                                --user "${BITBUCKET_USER}:${BITBUCKET_PWD}" \
                                "${BITBUCKET_URL}/rest/api/1.0/projects/${BITBUCKET_PROJECT}/repos/${BITBUCKET_REPOSITORY}/pull-requests?state=OPEN&limit=100" \
                                > open-pull-requests.json
                        '''
                    }

                    def response = readJSON(
                        file: 'open-pull-requests.json',
                        returnPojo: true
                    )

                    def existingPr = response.values?.find { pr ->
                        pr.fromRef?.id ==
                            "refs/heads/${env.SYNC_BRANCH}" &&
                        pr.toRef?.id ==
                            "refs/heads/${env.TARGET_BRANCH}"
                    }

                    if (existingPr) {
                        OPEN_PR_FOUND = true
                        PULL_REQUEST_URL =
                            getPullRequestUrl(existingPr.id)

                        echo "Existing PR updated: ${PULL_REQUEST_URL}"
                    } else {
                        echo 'No existing open synchronization PR found.'
                    }
                }
            }
        }

        stage('Create Pull Request') {
            when {
                expression {
                    SYNC_CHANGES && !OPEN_PR_FOUND
                }
            }

            steps {
                script {
                    def payload = [
                        title: 'DEV Server Synchronization',

                        description:
                            "Synchronize business packages from " +
                            "${env.SOURCE_SERVER} into " +
                            "${env.TARGET_BRANCH}.\n\n" +
                            "Excluded packages: Wm*, Wx*, Test*, " +
                            "Sample*, Default, MSTest and " +
                            "TerracottaExamples.\n\n" +
                            "Jenkins build: ${env.BUILD_URL}",

                        state: 'OPEN',
                        open: true,
                        closed: false,

                        fromRef: [
                            id: "refs/heads/${env.SYNC_BRANCH}",
                            repository: [
                                slug: env.BITBUCKET_REPOSITORY,
                                project: [
                                    key: env.BITBUCKET_PROJECT
                                ]
                            ]
                        ],

                        toRef: [
                            id: "refs/heads/${env.TARGET_BRANCH}",
                            repository: [
                                slug: env.BITBUCKET_REPOSITORY,
                                project: [
                                    key: env.BITBUCKET_PROJECT
                                ]
                            ]
                        ]
                    ]

                    writeJSON(
                        file: 'pull-request.json',
                        json: payload
                    )

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'Admin_Bitbucket',
                            usernameVariable: 'BITBUCKET_USER',
                            passwordVariable: 'BITBUCKET_PWD'
                        )
                    ]) {
                        sh '''
                            curl \
                                --fail \
                                --silent \
                                --show-error \
                                --user "${BITBUCKET_USER}:${BITBUCKET_PWD}" \
                                --header "Content-Type: application/json" \
                                --data @pull-request.json \
                                "${BITBUCKET_URL}/rest/api/1.0/projects/${BITBUCKET_PROJECT}/repos/${BITBUCKET_REPOSITORY}/pull-requests" \
                                > pull-request-response.json
                        '''
                    }

                    def response = readJSON(
                        file: 'pull-request-response.json',
                        returnPojo: true
                    )

                    if (!response.id) {
                        error(
                            'Pull request ID was not returned by Bitbucket'
                        )
                    }

                    PULL_REQUEST_URL =
                        getPullRequestUrl(response.id)

                    echo "Pull request created: ${PULL_REQUEST_URL}"
                }
            }
        }
    }

    post {
        success {
            script {
                if (!SYNC_CHANGES) {
                    echo 'No business-package changes found.'
                    echo 'No branch or PR update was required.'
                } else if (OPEN_PR_FOUND) {
                    echo "Existing PR updated: ${PULL_REQUEST_URL}"
                } else {
                    echo "New PR created: ${PULL_REQUEST_URL}"
                }
            }
        }

        failure {
            echo 'DEV server synchronization failed.'
        }

        always {
            sh '''
                rm -rf "${SYNC_DIRECTORY}" || true

                rm -f \
                    pull-request.json \
                    pull-request-response.json \
                    open-pull-requests.json || true
            '''

            archiveArtifacts(
                artifacts: 'packages-to-sync.txt',
                allowEmptyArchive: true
            )
        }
    }
}

def getRemoteServer() {
    return [
        name: env.SOURCE_SERVER,
        host: env.SOURCE_HOST,
        user: env.SERVER_SSH_USER,
        password: env.SSH_PASSWORD,
        allowAnyHosts: true,
        timeoutSec: 30
    ]
}

def readPackageFile() {
    if (!fileExists('packages-to-sync.txt')) {
        error('packages-to-sync.txt not found')
    }

    def packages = readFile(
        file: 'packages-to-sync.txt',
        encoding: 'UTF-8'
    )
    .readLines()
    .collect { it.trim() }
    .findAll { it }

    if (packages.isEmpty()) {
        error('No packages found to synchronize')
    }

    return packages
}

def getPullRequestUrl(prId) {
    return "${env.BITBUCKET_URL}" +
        "/projects/${env.BITBUCKET_PROJECT}" +
        "/repos/${env.BITBUCKET_REPOSITORY}" +
        "/pull-requests/${prId}/overview"
}