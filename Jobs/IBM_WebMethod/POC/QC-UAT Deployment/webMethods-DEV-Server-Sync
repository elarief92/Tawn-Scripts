properties([])

pipeline {
    agent { label 'SAG-PREP-IPP02' }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
        skipDefaultCheckout(true)
    }

    environment {
        ENVIRONMENT_NAME = 'DEV'

        SOURCE_SERVER = 'PREPROD_APP02'
        SOURCE_HOST = '10.7.248.75'

        SERVER_SSH_USER = 'apiadmin'
        SERVER_PACKAGE_ROOT = '/sag/dbp1011/IntegrationServer/instances/default/packages'

        TARGET_BRANCH = 'DEV_CICD'
        SYNC_BRANCH = 'server-sync/DEV'

        BITBUCKET_URL = 'https://bitbucket.tawn.com'
        BITBUCKET_PROJECT = 'EI'
        BITBUCKET_REPOSITORY = 'webmethods-source-code'
        GIT_REMOTE = 'webmethods-source-code'

        SYNC_DIRECTORY = "${WORKSPACE}/.server_sync"

        EMAIL_RECIPIENTS = 'melarief@tawuniya.com'
        EMAIL_SUBJECT = 'webMethods DEV Server Synchronization'

        PR_REVIEWER_USERNAME = 'melarief'

        CHANGED_PACKAGES_FILE = "${WORKSPACE}/changed-packages.txt"
        HTML_REPORT_FILE = "${WORKSPACE}/sync-report.html"

        SYNC_CHANGES = 'false'
        OPEN_PR_FOUND = 'false'
        PULL_REQUEST_URL = ''
    }

    stages {
        stage('Set Build Information') {
            steps {
                script {
                    currentBuild.displayName =
                        "DEV-SYNC-${env.BUILD_NUMBER}"

                    currentBuild.description =
                        "SOURCE=${env.SOURCE_SERVER} | " +
                        "TARGET=${env.TARGET_BRANCH}"

                    echo "Environment: ${env.ENVIRONMENT_NAME}"
                    echo "Execution agent: ${env.NODE_NAME}"
                    echo "Source server: ${env.SOURCE_SERVER}"
                    echo "Source host: ${env.SOURCE_HOST}"
                    echo "Target branch: ${env.TARGET_BRANCH}"
                    echo "Sync branch: ${env.SYNC_BRANCH}"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                deleteDir()

                bbs_checkout(
                    branches: [
                        [name: "*/${env.TARGET_BRANCH}"]
                    ],
                    credentialsId: 'Admin_Bitbucket',
                    id: '06c55797-80ad-4cb9-bea7-299d2a91506e',
                    projectName: 'EI',
                    repositoryName: 'webmethods-source-code',
                    serverId: '2492752c-5622-4c29-9972-c1c0f572b1f6'
                )
            }
        }

        stage('Resolve Packages') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'IS_Server_SSH',
                            usernameVariable: 'SSH_USER',
                            passwordVariable: 'SSH_PASSWORD'
                        )
                    ]) {
                        def output = sshCommand(
                            remote: getRemoteServer(),
                            command: """
                                set -e

                                test -d '${env.SERVER_PACKAGE_ROOT}'

                                find '${env.SERVER_PACKAGE_ROOT}' \
                                    -mindepth 1 \
                                    -maxdepth 1 \
                                    -type d \
                                    ! -name 'Wm*' \
                                    ! -name 'Wx*' \
                                    ! -name 'Test*' \
                                    ! -name 'Sample*' \
                                    ! -name 'Default' \
                                    ! -name 'MSTest' \
                                    ! -name 'TerracottaExamples' \
                                    -printf '%f\\n' |
                                sort
                            """.stripIndent().trim()
                        )

                        def packages = output
                            .readLines()
                            .collect { it.trim() }
                            .findAll { it }

                        if (packages.isEmpty()) {
                            error(
                                "No business packages found on " +
                                "${env.SOURCE_SERVER}"
                            )
                        }

                        writeFile(
                            file: 'packages-to-sync.txt',
                            text: packages.join('\n') + '\n',
                            encoding: 'UTF-8'
                        )

                        echo "Packages found: ${packages.size()}"
                        echo "Packages: ${packages.join(', ')}"
                    }
                }
            }
        }

        stage('Synchronize Packages') {
            steps {
                script {
                    def packages = readPackageFile()

                    def packageArguments = packages
                        .collect { "'${it}'" }
                        .join(' ')

                    def remoteArchive =
                        "/tmp/jenkins-dev-sync-" +
                        "${env.BUILD_NUMBER}.tar.gz"

                    def localArchive =
                        "${env.SYNC_DIRECTORY}/packages.tar.gz"

                    sh '''
                        set -e

                        if [ -z "${SYNC_DIRECTORY}" ]; then
                            echo "ERROR: SYNC_DIRECTORY is empty"
                            exit 1
                        fi

                        rm -rf "${SYNC_DIRECTORY}"
                        mkdir -p "${SYNC_DIRECTORY}"
                    '''

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'IS_Server_SSH',
                            usernameVariable: 'SSH_USER',
                            passwordVariable: 'SSH_PASSWORD'
                        )
                    ]) {
                        def remote = getRemoteServer()

                        try {
                            sshCommand(
                                remote: remote,
                                command: """
                                    set -e

                                    rm -f '${remoteArchive}'

                                    tar \
                                        -C '${env.SERVER_PACKAGE_ROOT}' \
                                        --exclude='*.log' \
                                        --exclude='*.tmp' \
                                        --exclude='*.lck' \
                                        --exclude='*.lock' \
                                        --exclude='*.bak' \
                                        --exclude='*/logs/*' \
                                        --exclude='*/log/*' \
                                        --exclude='*/cache/*' \
                                        --exclude='*/temp/*' \
                                        --exclude='*/tmp/*' \
                                        --exclude='*/stats/*' \
                                        --exclude='*/audit/*' \
                                        -czf '${remoteArchive}' \
                                        ${packageArguments}

                                    test -s '${remoteArchive}'
                                """.stripIndent().trim()
                            )

                            sshGet(
                                remote: remote,
                                from: remoteArchive,
                                into: localArchive,
                                override: true
                            )
                        } finally {
                            sshCommand(
                                remote: remote,
                                command: "rm -f '${remoteArchive}'",
                                failOnError: false
                            )
                        }
                    }

                    sh '''
                        set -e

                        test -f "${SYNC_DIRECTORY}/packages.tar.gz"

                        tar -xzf \
                            "${SYNC_DIRECTORY}/packages.tar.gz" \
                            -C "${SYNC_DIRECTORY}"

                        while IFS= read -r PACKAGE_NAME; do
                            [ -n "${PACKAGE_NAME}" ] || continue

                            SOURCE_PATH="${SYNC_DIRECTORY}/${PACKAGE_NAME}"
                            TARGET_PATH="${WORKSPACE}/IS/${PACKAGE_NAME}"

                            if [ ! -d "${SOURCE_PATH}" ]; then
                                echo "ERROR: Package not extracted: ${PACKAGE_NAME}"
                                exit 1
                            fi

                            rm -rf "${TARGET_PATH}"
                            mkdir -p "${TARGET_PATH}"

                            cp -a \
                                "${SOURCE_PATH}/." \
                                "${TARGET_PATH}/"
                        done < packages-to-sync.txt

                        rm -f "${SYNC_DIRECTORY}/packages.tar.gz"
                    '''
                }
            }
        }

        stage('Remove Runtime Files') {
            steps {
                sh '''
                    set -e

                    while IFS= read -r PACKAGE_NAME; do
                        [ -n "${PACKAGE_NAME}" ] || continue

                        PACKAGE_PATH="${WORKSPACE}/IS/${PACKAGE_NAME}"

                        find "${PACKAGE_PATH}" \
                            -type f \
                            -name '*.log' \
                            -delete

                        find "${PACKAGE_PATH}" \
                            -type f \
                            -name '*.tmp' \
                            -delete

                        find "${PACKAGE_PATH}" \
                            -type f \
                            -name '*.lck' \
                            -delete

                        find "${PACKAGE_PATH}" \
                            -type f \
                            -name '*.lock' \
                            -delete

                        find "${PACKAGE_PATH}" \
                            -type f \
                            -name '*.bak' \
                            -delete

                        for RUNTIME_DIR in \
                            logs log cache temp tmp stats audit
                        do
                            find "${PACKAGE_PATH}" \
                                -type d \
                                -name "${RUNTIME_DIR}" \
                                -prune \
                                -exec rm -rf {} +
                        done

                    done < packages-to-sync.txt
                '''
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def status = sh(
                        script: '''
                            git status --porcelain -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**'
                        ''',
                        returnStdout: true
                    ).trim()

                    env.SYNC_CHANGES =
                        status ? 'true' : 'false'

                    if (env.SYNC_CHANGES == 'true') {
                        echo 'Business package differences detected.'

                        sh '''
                            git status --porcelain -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**' \
                            | sed 's/^...//' \
                            | awk -F/ 'NF >= 2 {print $2}' \
                            | sort -u \
                            > "${CHANGED_PACKAGES_FILE}"

                            echo "Changed packages:"
                            cat "${CHANGED_PACKAGES_FILE}"

                            git diff --stat -- IS \
                                ':(exclude)IS/Wm*/**' \
                                ':(exclude)IS/Wx*/**' \
                                ':(exclude)IS/Test*/**' \
                                ':(exclude)IS/Sample*/**' \
                                ':(exclude)IS/Default/**' \
                                ':(exclude)IS/MSTest/**' \
                                ':(exclude)IS/TerracottaExamples/**'
                        '''
                    } else {
                        writeFile(
                            file: env.CHANGED_PACKAGES_FILE,
                            text: 'No package changes detected.\n',
                            encoding: 'UTF-8'
                        )

                        echo 'No business package differences detected.'
                    }

                    createHtmlReport()
                }
            }
        }

        stage('Commit And Push') {
            when {
                expression {
                    env.SYNC_CHANGES == 'true'
                }
            }

            steps {
                sh '''
                    set -e

                    git config \
                        user.name \
                        "Jenkins webMethods Sync"

                    git config \
                        user.email \
                        "jenkins@tawuniya.com"

                    git checkout -B "${SYNC_BRANCH}"

                    git add -A -- IS \
                        ':(exclude)IS/Wm*/**' \
                        ':(exclude)IS/Wx*/**' \
                        ':(exclude)IS/Test*/**' \
                        ':(exclude)IS/Sample*/**' \
                        ':(exclude)IS/Default/**' \
                        ':(exclude)IS/MSTest/**' \
                        ':(exclude)IS/TerracottaExamples/**'

                    if git diff --cached --quiet; then
                        echo "ERROR: No staged business-package changes found"
                        exit 1
                    fi

                    git commit \
                        -m "Daily DEV server synchronization"
                '''

                withCredentials([
                    gitUsernamePassword(
                        credentialsId: 'Admin_Bitbucket',
                        gitToolName: 'Default'
                    )
                ]) {
                    sh '''
                        git push \
                            --force \
                            "${GIT_REMOTE}" \
                            "HEAD:refs/heads/${SYNC_BRANCH}"
                    '''
                }
            }
        }

        stage('Check Existing PR') {
            when {
                expression {
                    env.SYNC_CHANGES == 'true'
                }
            }

            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'Admin_Bitbucket',
                            usernameVariable: 'BITBUCKET_USER',
                            passwordVariable: 'BITBUCKET_PWD'
                        )
                    ]) {
                        sh '''
                            curl \
                                --fail \
                                --silent \
                                --show-error \
                                --user "${BITBUCKET_USER}:${BITBUCKET_PWD}" \
                                "${BITBUCKET_URL}/rest/api/1.0/projects/${BITBUCKET_PROJECT}/repos/${BITBUCKET_REPOSITORY}/pull-requests?state=OPEN&limit=100" \
                                > open-pull-requests.json
                        '''
                    }

                    def response = readJSON(
                        file: 'open-pull-requests.json',
                        returnPojo: true
                    )

                    def existingPr = response.values?.find { pr ->
                        pr.fromRef?.id ==
                            "refs/heads/${env.SYNC_BRANCH}" &&
                        pr.toRef?.id ==
                            "refs/heads/${env.TARGET_BRANCH}"
                    }

                    if (existingPr) {
                        env.OPEN_PR_FOUND = 'true'

                        env.PULL_REQUEST_URL =
                            getPullRequestUrl(existingPr.id)

                        echo(
                            "Existing PR updated: " +
                            "${env.PULL_REQUEST_URL}"
                        )

                        createHtmlReport()
                    } else {
                        env.OPEN_PR_FOUND = 'false'

                        echo(
                            'No existing open synchronization PR found.'
                        )
                    }
                }
            }
        }

        stage('Create Pull Request') {
            when {
                expression {
                    env.SYNC_CHANGES == 'true' &&
                    env.OPEN_PR_FOUND != 'true'
                }
            }

            steps {
                script {
                    def payload = [
                        title:
                            'DEV Server Synchronization',

                        description:
                            "Synchronize business packages from " +
                            "${env.SOURCE_SERVER} into " +
                            "${env.TARGET_BRANCH}.\n\n" +
                            "Excluded packages: Wm*, Wx*, Test*, " +
                            "Sample*, Default, MSTest and " +
                            "TerracottaExamples.\n\n" +
                            "Jenkins build: ${env.BUILD_URL}",

                        state: 'OPEN',
                        open: true,
                        closed: false,

                        reviewers: [
                            [
                                user: [
                                    name:
                                        env.PR_REVIEWER_USERNAME
                                ]
                            ]
                        ],

                        fromRef: [
                            id:
                                "refs/heads/${env.SYNC_BRANCH}",

                            repository: [
                                slug:
                                    env.BITBUCKET_REPOSITORY,

                                project: [
                                    key:
                                        env.BITBUCKET_PROJECT
                                ]
                            ]
                        ],

                        toRef: [
                            id:
                                "refs/heads/${env.TARGET_BRANCH}",

                            repository: [
                                slug:
                                    env.BITBUCKET_REPOSITORY,

                                project: [
                                    key:
                                        env.BITBUCKET_PROJECT
                                ]
                            ]
                        ]
                    ]

                    writeJSON(
                        file: 'pull-request.json',
                        json: payload
                    )

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'Admin_Bitbucket',
                            usernameVariable: 'BITBUCKET_USER',
                            passwordVariable: 'BITBUCKET_PWD'
                        )
                    ]) {
                        sh '''
                            curl \
                                --fail \
                                --silent \
                                --show-error \
                                --user "${BITBUCKET_USER}:${BITBUCKET_PWD}" \
                                --header "Content-Type: application/json" \
                                --data @pull-request.json \
                                "${BITBUCKET_URL}/rest/api/1.0/projects/${BITBUCKET_PROJECT}/repos/${BITBUCKET_REPOSITORY}/pull-requests" \
                                > pull-request-response.json
                        '''
                    }

                    def response = readJSON(
                        file: 'pull-request-response.json',
                        returnPojo: true
                    )

                    if (!response.id) {
                        error(
                            'Pull request ID was not returned by Bitbucket'
                        )
                    }

                    env.PULL_REQUEST_URL =
                        getPullRequestUrl(response.id)

                    echo(
                        "Pull request created: " +
                        "${env.PULL_REQUEST_URL}"
                    )

                    createHtmlReport()
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.SYNC_CHANGES == 'true') {
                    sendSyncEmail(
                        'Success',
                        '#27ae60',
                        'Server differences were detected and synchronized.'
                    )
                } else {
                    sendSyncEmail(
                        'Success - No Changes',
                        '#2980b9',
                        'No server-to-Git differences were detected.'
                    )
                }
            }
        }

        failure {
            script {
                sendSyncEmail(
                    'Failed',
                    '#c0392b',
                    'The DEV server synchronization job failed.'
                )
            }
        }

        aborted {
            script {
                sendSyncEmail(
                    'Aborted',
                    '#7f8c8d',
                    'The DEV server synchronization job was aborted.'
                )
            }
        }

        always {
            archiveArtifacts(
                artifacts:
                    'packages-to-sync.txt, ' +
                    'changed-packages.txt, ' +
                    'sync-report.html',
                allowEmptyArchive: true
            )

            sh '''
                rm -rf "${SYNC_DIRECTORY}" || true

                rm -f \
                    pull-request.json \
                    pull-request-response.json \
                    open-pull-requests.json || true
            '''

            echo 'DEV server synchronization finished.'
        }
    }
}

def getRemoteServer() {
    return [
        name: env.SOURCE_SERVER,
        host: env.SOURCE_HOST,
        user: env.SERVER_SSH_USER,
        password: env.SSH_PASSWORD,
        allowAnyHosts: true,
        timeoutSec: 30
    ]
}

def readPackageFile() {
    if (!fileExists('packages-to-sync.txt')) {
        error('packages-to-sync.txt not found')
    }

    def packages = readFile(
        file: 'packages-to-sync.txt',
        encoding: 'UTF-8'
    )
    .readLines()
    .collect { it.trim() }
    .findAll { it }

    if (packages.isEmpty()) {
        error('No packages found to synchronize')
    }

    return packages
}

def getPullRequestUrl(prId) {
    return "${env.BITBUCKET_URL}" +
        "/projects/${env.BITBUCKET_PROJECT}" +
        "/repos/${env.BITBUCKET_REPOSITORY}" +
        "/pull-requests/${prId}/overview"
}

def createHtmlReport() {
    def changedPackages = []

    if (fileExists(env.CHANGED_PACKAGES_FILE)) {
        changedPackages = readFile(
            file: env.CHANGED_PACKAGES_FILE,
            encoding: 'UTF-8'
        )
        .readLines()
        .collect { it.trim() }
        .findAll { it }
    }

    def packageRows = changedPackages.collect { packageName ->
        "<tr><td>${packageName}</td></tr>"
    }.join('\n')

    if (!packageRows) {
        packageRows =
            '<tr><td>No package information available.</td></tr>'
    }

    def pullRequestDisplay = env.PULL_REQUEST_URL?.trim()
        ? "<a href='${env.PULL_REQUEST_URL}'>" +
          "${env.PULL_REQUEST_URL}</a>"
        : 'Not created'

    def report = """\
        <!DOCTYPE html>
        <html lang="en">
        <head>
            <meta charset="UTF-8">

            <style>
                body {
                    font-family: Arial, sans-serif;
                    background: #f4f4f4;
                    color: #333;
                }

                .container {
                    width: 700px;
                    margin: 20px auto;
                    background: #fff;
                    padding: 20px;
                    border-radius: 8px;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                }

                th,
                td {
                    border: 1px solid #ddd;
                    padding: 8px;
                    text-align: left;
                }

                th {
                    background: #ecf0f1;
                }
            </style>
        </head>

        <body>
            <div class="container">
                <h2>
                    webMethods DEV Server Synchronization
                </h2>

                <p>
                    <strong>Source server:</strong>
                    ${env.SOURCE_SERVER}
                </p>

                <p>
                    <strong>Target branch:</strong>
                    ${env.TARGET_BRANCH}
                </p>

                <p>
                    <strong>Sync branch:</strong>
                    ${env.SYNC_BRANCH}
                </p>

                <p>
                    <strong>Changes detected:</strong>
                    ${env.SYNC_CHANGES == 'true' ? 'Yes' : 'No'}
                </p>

                <p>
                    <strong>Pull request:</strong>
                    ${pullRequestDisplay}
                </p>

                <h3>Changed Packages</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Package Name</th>
                        </tr>
                    </thead>

                    <tbody>
                        ${packageRows}
                    </tbody>
                </table>

                <p>
                    <strong>Build:</strong>

                    <a href="${env.BUILD_URL}">
                        ${env.BUILD_URL}
                    </a>
                </p>
            </div>
        </body>
        </html>
    """.stripIndent()

    writeFile(
        file: env.HTML_REPORT_FILE,
        text: report,
        encoding: 'UTF-8'
    )
}

def sendSyncEmail(status, color, message) {
    if (!fileExists(env.HTML_REPORT_FILE)) {
        createHtmlReport()
    }

    def report = readFile(
        file: env.HTML_REPORT_FILE,
        encoding: 'UTF-8'
    )

    def header = """
        <h2 style="color:${color}">
            webMethods DEV Server Synchronization - ${status}
        </h2>

        <p>${message}</p>
    """.stripIndent()

    report = report.replace(
        '<h2>\n                    webMethods DEV Server Synchronization\n                </h2>',
        header
    )

    emailext(
        to: env.EMAIL_RECIPIENTS,

        subject:
            "${env.EMAIL_SUBJECT} - " +
            "${status} - #${env.BUILD_NUMBER}",

        mimeType: 'text/html',
        body: report,

        attachmentsPattern:
            'changed-packages.txt, sync-report.html'
    )
}