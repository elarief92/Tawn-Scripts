properties([
    parameters([
        string(name: 'EPIC_NAME', defaultValue: '', description: 'Use a Valid Jira Epic Number'),

        [$class: 'ChoiceParameter', choiceType: 'PT_CHECKBOX', name: 'TARGET_SCOPE', description: 'Select DEV target servers', filterable: true, filterLength: 2, script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return ["PREPROD_APP01"]'], script: [classpath: [], sandbox: true, script: 'return ["PREPROD_APP01", "PREPROD_APP02"]']]],

        [
            $class: 'ChoiceParameter',
            choiceType: 'PT_CHECKBOX',
            name: 'PACKAGES_TO_BUILD',
            description: 'Select packages to build and deploy',
            filterable: true,
            filterLength: 2,
            script: [
                $class: 'GroovyScript',
                fallbackScript: [classpath: [], sandbox: true, script: 'return ["PSUtilities"]'],
                script: [
                    classpath: [],
                    sandbox: true,
                    script: '''
                        return [
                            "PSUtilities",
                            "TawncheckoutPayment",
                            "TawnMedDomesticWorker",
                            "TawnMobileApplication",
                            "TawnMotorNonRetail",
                            "TawnSMEMedicalProcess",
                            "TawnSMESalesCRM",
                            "zzCharan",
                            "zzConnectivityCheck",
                            "zzHanu",
                            "zzwebmpoc"
                        ]
                    '''
                ]
            ]
        ]
    ])
])

def SELECTED_PACKAGES = []
def SELECTED_TARGETS = []

pipeline {
    agent { label 'SAG-PREP-IPP02' }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '3'))
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        ENVIRONMENT_NAME = 'DEV'
        BRANCH_NAME = 'DEV_CICD'

        SAG_HOME = '/sag/be1015'
        JAVA_HOME = '/sag/be1015/jvm/jvm'

        ABE_BUILD_FILE = "${SAG_HOME}/common/AssetBuildEnvironment/master_build/build.xml"
        DEPLOYER_BIN = "${SAG_HOME}/IntegrationServer/instances/default/packages/WmDeployer/bin"
        PROJECT_AUTOMATOR = "${DEPLOYER_BIN}/projectautomatorUnix.sh"
        DEPLOYER_CMD = "${DEPLOYER_BIN}/Deployer.sh"

        TEMP_SRC = "${WORKSPACE}/.tmp_build_src"
        BUILD_OUTPUT_DIR = "${WORKSPACE}/build_output"
        GENERATED_DIR = "${WORKSPACE}/generated"
        GENERATED_XML = "${WORKSPACE}/generated/Deployment_ProjectAutomator.xml"
        BUILD_LOG_FILE = "${WORKSPACE}/generated/abe-build.log"

        TEMPLATE_XML = '01-deployer/templates/ProjectAutomator.Repository.template.xml'

        DEPLOYER_HOST = '127.0.0.1'
        DEPLOYER_PORT = '5555'
        REPO_ALIAS = 'BuildRepo'

        EMAIL_RECIPIENTS = 'melarief@tawuniya.com'
        EMAIL_SUBJECT = 'API Deployment'
        APPLICATION_NAME = 'webMethods API'

        NEED_ROLLBACK = 'false'
        ROLLBACK_REQUIRED = 'false'
        DEPLOYMENT_FAILED = 'false'
        DEPLOY_EXIT_CODE = '0'
        ROLLBACK_STATUS = 'NOT_REQUIRED'
    }

    stages {
        stage('Validate Input') {
            steps {
                script {
                    if (!params.EPIC_NAME?.trim()) {
                        error('EPIC_NAME is required')
                    }

                    SELECTED_PACKAGES = getSelected(params.PACKAGES_TO_BUILD)
                    SELECTED_TARGETS = getSelected(params.TARGET_SCOPE)

                    if (SELECTED_PACKAGES.isEmpty()) {
                        error('Select at least one package')
                    }

                    if (SELECTED_TARGETS.isEmpty()) {
                        error('Select at least one target server')
                    }

                    echo "Environment: ${env.ENVIRONMENT_NAME}"
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Jenkins agent: ${env.NODE_NAME}"
                    echo "Packages: ${SELECTED_PACKAGES.join(', ')}"
                    echo "Targets: ${SELECTED_TARGETS.join(', ')}"
                }
            }
        }

        stage('Set Build Name') {
            steps {
                script {
                    currentBuild.displayName = "${params.EPIC_NAME}"
                    currentBuild.description = "EPIC=${params.EPIC_NAME} | ENV=${env.ENVIRONMENT_NAME} | AGENT=${env.NODE_NAME}"
                }
            }
        }

        stage('Send Start Email') {
            steps {
                script {
                    sendDeploymentEmail(
                        'Started',
                        '#2c3e50',
                        "We are pleased to inform you that the deployment of ${env.APPLICATION_NAME} has started as follows:",
                        getSelected(params.TARGET_SCOPE).join(', ')
                    )
                }
            }
        }

        stage('Checkout Repo') {
            steps {
                script {
                    echo "Environment selected: ${env.ENVIRONMENT_NAME}"
                    echo "Branch selected for checkout: ${env.BRANCH_NAME}"
                    echo "Running on Jenkins agent: ${env.NODE_NAME}"
        
                    bbs_checkout(
                        branches: [[name: "*/${env.BRANCH_NAME}"]],
                        credentialsId: 'Admin_Bitbucket',
                        id: '06c55797-80ad-4cb9-bea7-299d2a91506e',
                        projectName: 'EI',
                        repositoryName: 'webmethods-source-code',
                        serverId: '2492752c-5622-4c29-9972-c1c0f572b1f6',
                        cloneOptions: [
                            shallow: false
                        ],
                        cleanBeforeCheckout: true
                    )
                }
            }
        }

        stage('Validate Repo Content') {
            steps {
                script {
                    if (!fileExists(env.TEMPLATE_XML)) {
                        error("Template XML not found after checkout: ${env.TEMPLATE_XML}")
                    }

                    for (pkg in SELECTED_PACKAGES) {
                        if (!fileExists("IS/${pkg}")) {
                            error("Package not found in repo: IS/${pkg}")
                        }
                    }
                }
            }
        }

        stage('Validate Tools') {
            steps {
                script {
                    def abeCommand = "${env.SAG_HOME}/common/AssetBuildEnvironment/bin/build.sh"
                    def javaCommand = "${env.JAVA_HOME}/bin/java"

                    if (!fileExists(abeCommand)) {
                        error("ABE build command not found: ${abeCommand}")
                    }

                    if (!fileExists(env.ABE_BUILD_FILE)) {
                        error("ABE build file not found: ${env.ABE_BUILD_FILE}")
                    }

                    if (!fileExists(javaCommand)) {
                        error("Java executable not found: ${javaCommand}")
                    }

                    if (!fileExists(env.PROJECT_AUTOMATOR)) {
                        error("Project Automator script not found: ${env.PROJECT_AUTOMATOR}")
                    }

                    if (!fileExists(env.DEPLOYER_CMD)) {
                        error("Deployer command not found: ${env.DEPLOYER_CMD}")
                    }
                }
            }
        }

        stage('Clean Existing Deployer Project') {
            steps {
                cleanExistingDeployerProject()
            }
        }

        stage('Prepare Build Source') {
            steps {
                sh '''
                    echo "Cleaning previous build directories and status files..."
        
                    rm -rf "${TEMP_SRC}" \
                           "${BUILD_OUTPUT_DIR}" \
                           "${GENERATED_DIR}"
        
                    rm -f "${WORKSPACE}/build_output.zip" \
                          "${WORKSPACE}/.deployment_failed" \
                          "${WORKSPACE}/.rollback_status"
        
                    mkdir -p "${TEMP_SRC}" \
                             "${BUILD_OUTPUT_DIR}" \
                             "${GENERATED_DIR}"
                '''
        
                script {
                    for (pkg in SELECTED_PACKAGES) {
                        sh """
                            echo "Preparing package: ${pkg}"
        
                            if [ ! -d "${env.WORKSPACE}/IS/${pkg}" ]; then
                                echo "ERROR: Package directory is missing: IS/${pkg}"
                                exit 1
                            fi
        
                            mkdir -p "${env.TEMP_SRC}/${pkg}"
        
                            cp -R \
                                "${env.WORKSPACE}/IS/${pkg}/." \
                                "${env.TEMP_SRC}/${pkg}/"
        
                            echo "Package prepared successfully: ${pkg}"
                        """
                    }
                }
        
                sh '''
                    echo "Prepared build source:"
                    find "${TEMP_SRC}" \
                        -mindepth 1 \
                        -maxdepth 1 \
                        -type d \
                        -printf '%f\n' | sort
                '''
            }
        }

        stage('ABE Build') {
            steps {
                sh '''
                    set -o pipefail

                    export PATH=$JAVA_HOME/bin:$PATH
                    unset CLASSPATH

                    export ANT_OPTS="-Xms2g -Xmx16g -XX:+UseG1GC"
                    export JAVA_OPTS="-Xms2g -Xmx16g -XX:+UseG1GC"
                    export _JAVA_OPTIONS="-Xms2g -Xmx16g -XX:+UseG1GC"

                    "${SAG_HOME}/common/AssetBuildEnvironment/bin/build.sh" \
                        -Dbuild.output.dir="${BUILD_OUTPUT_DIR}" \
                        -Dbuild.source.dir="${TEMP_SRC}" \
                        -Denable.checkout=false \
                        -Denable.archive=false \
                        -Denable.build.IS=true \
                        2>&1 | tee "${BUILD_LOG_FILE}"
                '''
            }
        }

        stage('Validate ABE Output') {
            steps {
                sh '''
                    echo "Checking ABE output..."
                    find "${BUILD_OUTPUT_DIR}" -maxdepth 3 -type f | sort

                    if [ ! -d "${BUILD_OUTPUT_DIR}/IS" ]; then
                        echo "ERROR: ${BUILD_OUTPUT_DIR}/IS not found"
                        exit 1
                    fi

                    if ! ls "${BUILD_OUTPUT_DIR}/IS"/*.acdl >/dev/null 2>&1; then
                        echo "ERROR: No ACDL files generated"
                        exit 1
                    fi
                '''
            }
        }

        stage('Generate Project Automator XML') {
            steps {
                script {
                    generateProjectAutomatorXml(
                        SELECTED_PACKAGES,
                        SELECTED_TARGETS
                    )
                }
            }
        }

        stage('Create Deployer Project') {
            steps {
                createDeployerProject()
            }
        }

        stage('Create Snapshot') {
            steps {
                script {
                    createSnapshot()
                }
            }
        }

        stage('Deploy Candidate') {
            steps {
                script {
                    int deployStatus = deployCandidate()
        
                    if (deployStatus != 0) {
                        writeFile(
                            file: '.deployment_failed',
                            text: deployStatus.toString()
                        )
        
                        echo "Deployment failed with exit code ${deployStatus}."
                        echo 'Automatic rollback is required.'
                    } else {
                        echo 'Deployment completed successfully.'
                    }
                }
            }
        }
        
        stage('Automatic Rollback') {
            steps {
                script {
                    if (fileExists('.deployment_failed')) {
                        echo 'Starting automatic rollback.'
        
                        int rollbackExitCode = rollbackDeployment()
                        String rollbackResult =
                            rollbackExitCode == 0 ? 'SUCCESS' : 'FAILED'
        
                        writeFile(
                            file: '.rollback_status',
                            text: rollbackResult
                        )
        
                        echo "Rollback status: ${rollbackResult}"
                    } else {
                        echo 'Rollback skipped because deployment succeeded.'
                    }
                }
            }
        }
        
        stage('Clean Failed Deployer Project') {
            steps {
                script {
                    if (fileExists('.deployment_failed')) {
                        echo "Cleaning failed Deployer project: ${params.EPIC_NAME}"
                        cleanExistingDeployerProject()
                    } else {
                        echo 'Failed-project cleanup skipped because deployment succeeded.'
                    }
                }
            }
        }

        stage('Zip Build Output') {
            steps {
                zipBuildOutput()
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts(
                    artifacts: 'generated/*.log, build_output.zip',
                    allowEmptyArchive: true
                )
            }
        }
        

        
        stage('Set Final Deployment Result') {
            steps {
                script {
                    if (fileExists('.deployment_failed')) {
                        def deployExitCode = readFile(
                            file: '.deployment_failed'
                        ).trim()
        
                        def rollbackStatus = fileExists('.rollback_status')
                            ? readFile(file: '.rollback_status').trim()
                            : 'UNKNOWN'
        
                        env.DEPLOYMENT_FAILED = 'true'
                        env.ROLLBACK_REQUIRED = 'true'
                        env.DEPLOY_EXIT_CODE = deployExitCode
                        env.ROLLBACK_STATUS = rollbackStatus
        
                        error(
                            "Deployment failed with exit code ${deployExitCode}. " +
                            "Rollback status: ${rollbackStatus}."
                        )
                    }
        
                    echo 'Deployment and post-deployment steps completed successfully.'
                }
            }
        }
    }

    post {
        success {
            script {
                sendDeploymentEmail(
                    'Success',
                    '#27ae60',
                    "We are pleased to inform you that the deployment of ${env.APPLICATION_NAME} has been completed successfully as follows:",
                    getSelected(params.TARGET_SCOPE).join(', ')
                )
            }
        }

        failure {
            script {
                sendDeploymentEmail(
                    'Failed',
                    '#c0392b',
                    "Please be informed that the deployment of ${env.APPLICATION_NAME} has failed as follows:",
                    getSelected(params.TARGET_SCOPE).join(', ')
                )
            }
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}

def cleanExistingDeployerProject() {
    withCredentials([
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'DEPLOYER_USER',
            passwordVariable: 'DEPLOYER_PWD'
        )
    ]) {
        sh '''
            echo "Cleaning existing Deployer resources for project: ${EPIC_NAME}"

            chmod +x "${DEPLOYER_CMD}" || true

            "${DEPLOYER_CMD}" --delete \
                -project "${EPIC_NAME}" \
                -dc "${EPIC_NAME}" \
                -host "${DEPLOYER_HOST}" \
                -port "${DEPLOYER_PORT}" \
                -user "${DEPLOYER_USER}" \
                -pwd "${DEPLOYER_PWD}" || true

            "${DEPLOYER_CMD}" --delete \
                -project "${EPIC_NAME}" \
                -host "${DEPLOYER_HOST}" \
                -port "${DEPLOYER_PORT}" \
                -user "${DEPLOYER_USER}" \
                -pwd "${DEPLOYER_PWD}" || true

            echo "Cleanup completed."
        '''
    }
}

def generateProjectAutomatorXml(packages, selectedTargets) {
    def targets = getTargetConfigs(selectedTargets)
    def names = buildNames(params.EPIC_NAME)
    def xml = readFile(file: env.TEMPLATE_XML, encoding: 'UTF-8')

    xml = xml.replace('@DEPLOYER_HOST_PORT@', "${env.DEPLOYER_HOST}:${env.DEPLOYER_PORT}")
    xml = xml.replace('@PROJECT_NAME@', names.PROJECT_NAME)
    xml = xml.replace('@PROJECT_DESC@', names.PROJECT_DESC)
    xml = xml.replace('@DEPLOYMENT_SET_NAME@', names.DEPLOYMENT_SET_NAME)
    xml = xml.replace('@DEPLOYMENT_MAP_NAME@', names.DEPLOYMENT_MAP_NAME)
    xml = xml.replace('@CANDIDATE_NAME@', names.CANDIDATE_NAME)
    xml = xml.replace('@REPO_ALIAS@', env.REPO_ALIAS)
    xml = xml.replace('@REPO_DIRECTORY@', env.BUILD_OUTPUT_DIR)
    xml = xml.replace('@IS_ALIASES@', buildISAliases(targets))
    xml = xml.replace('@MAP_TARGET_ALIASES@', buildMapTargetAliases(targets))
    xml = xml.replace('@DEPLOYMENT_ENTRIES@', buildRepositoryEntries(packages, env.REPO_ALIAS))

    writeFile(
        file: env.GENERATED_XML,
        text: xml,
        encoding: 'UTF-8'
    )

    echo "Generated XML: ${env.GENERATED_XML}"
    echo 'XML generated successfully. Content hidden to avoid exposing credentials.'
}

def createDeployerProject() {
    if (!fileExists(env.GENERATED_XML)) {
        error("Generated Project Automator XML not found: ${env.GENERATED_XML}")
    }

    if (!fileExists(env.PROJECT_AUTOMATOR)) {
        error("Project Automator script not found: ${env.PROJECT_AUTOMATOR}")
    }

    withCredentials([
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'DEPLOYER_USER',
            passwordVariable: 'DEPLOYER_PWD'
        ),
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'IS_USER',
            passwordVariable: 'IS_PWD'
        )
    ]) {
        sh '''
            sed -i "s|\\${DEPLOYER_USER}|${DEPLOYER_USER}|g" "${GENERATED_XML}"
            sed -i "s|\\${DEPLOYER_PWD}|${DEPLOYER_PWD}|g" "${GENERATED_XML}"
            sed -i "s|\\${IS_USER}|${IS_USER}|g" "${GENERATED_XML}"
            sed -i "s|\\${IS_PWD}|${IS_PWD}|g" "${GENERATED_XML}"

            chmod +x "${PROJECT_AUTOMATOR}" || true
            "${PROJECT_AUTOMATOR}" "${GENERATED_XML}"
        '''
    }
}

def createSnapshot() {
    withCredentials([
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'DEPLOYER_USER',
            passwordVariable: 'DEPLOYER_PWD'
        )
    ]) {
        def snapshotStatus = sh(
            script: '''
                chmod +x "${DEPLOYER_CMD}" || true

                "${DEPLOYER_CMD}" --checkpoint \
                    -dc "${EPIC_NAME}" \
                    -project "${EPIC_NAME}" \
                    -host "${DEPLOYER_HOST}" \
                    -port "${DEPLOYER_PORT}" \
                    -user "${DEPLOYER_USER}" \
                    -pwd "${DEPLOYER_PWD}"
            ''',
            returnStatus: true
        )

        if (snapshotStatus != 0) {
            error("Snapshot creation failed with exit code ${snapshotStatus}. Deployment cannot continue.")
        }

        echo 'Snapshot created successfully.'
    }
}

def deployCandidate() {
    int deployStatus

    withCredentials([
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'DEPLOYER_USER',
            passwordVariable: 'DEPLOYER_PWD'
        )
    ]) {
        deployStatus = sh(
            script: '''
                chmod +x "${DEPLOYER_CMD}" || true

                "${DEPLOYER_CMD}" --deploy \
                    -project "${EPIC_NAME}" \
                    -dc "${EPIC_NAME}" \
                    -host "${DEPLOYER_HOST}" \
                    -port "${DEPLOYER_PORT}" \
                    -user "${DEPLOYER_USER}" \
                    -pwd "${DEPLOYER_PWD}" \
                    -force
            ''',
            returnStatus: true
        )
    }

    if (deployStatus != 0) {
        echo "Deployment failed with exit code ${deployStatus}."
    } else {
        echo 'Deployment succeeded.'
    }

    return deployStatus
}

def rollbackDeployment() {
    int rollbackStatus

    withCredentials([
        usernamePassword(
            credentialsId: 'IS_Target_Preprod',
            usernameVariable: 'DEPLOYER_USER',
            passwordVariable: 'DEPLOYER_PWD'
        )
    ]) {
        rollbackStatus = sh(
            script: '''
                echo "Automatic rollback started for project: ${EPIC_NAME}"

                chmod +x "${DEPLOYER_CMD}" || true

                "${DEPLOYER_CMD}" --rollback \
                    -project "${EPIC_NAME}" \
                    -dc "${EPIC_NAME}" \
                    -host "${DEPLOYER_HOST}" \
                    -port "${DEPLOYER_PORT}" \
                    -user "${DEPLOYER_USER}" \
                    -pwd "${DEPLOYER_PWD}"
            ''',
            returnStatus: true
        )
    }

    if (rollbackStatus == 0) {
        echo 'Automatic rollback completed successfully.'
    } else {
        echo "Automatic rollback failed with exit code ${rollbackStatus}."
    }

    return rollbackStatus
}

def zipBuildOutput() {
    sh '''
        cd "${WORKSPACE}"

        rm -f build_output.zip

        if [ -d build_output ]; then
            zip -r build_output.zip build_output
        else
            echo "build_output directory not found. Skipping zip."
        fi
    '''
}

