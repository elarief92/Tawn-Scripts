def getSelected(val) {
    val?.trim() ? val.split(',').collect { it.trim() }.findAll { it && it != 'None' } : []
}

def buildNames(epic) {
    def e = epic.trim()

    [
        PROJECT_NAME: e,
        PROJECT_DESC: "Project created for EPIC ${e} on ${env.ENVIRONMENT_NAME} environment - ${new Date().format('yyyy-MM-dd HH:mm:ss')}",
        DEPLOYMENT_SET_NAME: "${e}_DEPLOYMENT_SET",
        DEPLOYMENT_MAP_NAME: "${e}_DEPLOYMENT_MAP",
        CANDIDATE_NAME: e
    ]
}

def buildRepositoryEntries(packages, repositoryAlias) {
    packages.collect {
        """<Composite name="${it}" srcAlias="${repositoryAlias}" type="IS"/>"""
    }.join('\n')
}

def buildISAliases(targets) {
    targets.collect { target ->
        """            <isalias name="${target.alias}">
                <host>${target.host}</host>
                <port>${target.port}</port>
                <user>\${IS_USER}</user>
                <pwd>\${IS_PWD}</pwd>
                <useSSL>false</useSSL>
                <installDeployerResource>false</installDeployerResource>
                <Test>false</Test>
            </isalias>"""
    }.join('\n')
}

def buildMapTargetAliases(targets) {
    targets.collect {
        """<alias type="IS">${it.alias}</alias>"""
    }.join('\n')
}

def getTargetConfigs(serverNames) {
    def targetConfigMap = [
        'PREPROD_APP01': [alias: 'PREPROD_APP01', host: '10.7.248.74', port: '5555'],
        'PREPROD_APP02': [alias: 'PREPROD_APP02', host: '10.7.248.75', port: '5555']
    ]

    serverNames.each { targetName ->
        if (!targetConfigMap[targetName]) {
            error("No target configuration found for ${targetName}")
        }
    }

    serverNames.collect {
        targetConfigMap[it]
    }
}