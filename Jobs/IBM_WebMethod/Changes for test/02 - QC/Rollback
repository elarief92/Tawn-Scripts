properties([
    parameters([
        string(
            name: 'EPIC_NAME',
            defaultValue: '',
            description: 'Same EPIC used in the QC deployment job'
        ),

        booleanParam(
            name: 'CONFIRM_ROLLBACK',
            defaultValue: false,
            description: 'Must be checked before rollback execution'
        ),

        booleanParam(
            name: 'DELETE_CANDIDATE_AFTER_ROLLBACK',
            defaultValue: true,
            description: 'Delete the QC candidate after successful rollback'
        )
    ])
])

pipeline {
    agent { label 'HQV-SAG-DEPP01' }

    options {
        disableConcurrentBuilds()
        lock(resource: 'webMethods-Deployer-shared')
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
    }

    environment {
        ENVIRONMENT_NAME = 'QC'

        SAG_HOME = '/sag/dbp1011'

        DEPLOYER_BIN = "${SAG_HOME}/IntegrationServer/instances/default/packages/WmDeployer/bin"
        DEPLOYER_CMD = "${DEPLOYER_BIN}/Deployer.sh"

        DEPLOYER_HOST = '127.0.0.1'
        DEPLOYER_PORT = '5555'

        EMAIL_RECIPIENTS = 'melarief@tawuniya.com'
        EMAIL_SUBJECT = 'API QC Rollback'
        APPLICATION_NAME = 'webMethods API'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {

                    if (!params.EPIC_NAME?.trim()) {
                        error('EPIC_NAME is required')
                    }

                    if (!params.CONFIRM_ROLLBACK) {
                        error('CONFIRM_ROLLBACK must be checked before running rollback')
                    }

                    if (!fileExists(env.DEPLOYER_CMD)) {
                        error("Deployer command not found: ${env.DEPLOYER_CMD}")
                    }

                    currentBuild.displayName =
                        "ROLLBACK-${env.ENVIRONMENT_NAME}-${params.EPIC_NAME}"

                    currentBuild.description =
                        "Rollback EPIC=${params.EPIC_NAME} | ENV=${env.ENVIRONMENT_NAME}"

                    echo "Rollback Environment: ${env.ENVIRONMENT_NAME}"
                    echo "Rollback Project: ${params.EPIC_NAME}"
                    echo "Rollback Candidate: ${params.EPIC_NAME}_${env.ENVIRONMENT_NAME}"
                    echo "Delete candidate after rollback: ${params.DELETE_CANDIDATE_AFTER_ROLLBACK}"
                }
            }
        }

        stage('Approval Before Rollback') {
            steps {
                script {

                    def approval = input(
                        message: "Confirm ${env.ENVIRONMENT_NAME} rollback for EPIC ${params.EPIC_NAME}?",
                        ok: 'Rollback Now',
                        parameters: [
                            string(
                                name: 'APPROVER_COMMENT',
                                defaultValue: '',
                                description: 'Reason / approval comment'
                            )
                        ]
                    )

                    env.APPROVER_COMMENT = approval
                }
            }
        }

        stage('Send Rollback Start Email') {
            steps {
                script {

                    sendRollbackEmail(
                        'Started',
                        '#f39c12',
                        "Rollback has been started for ${env.APPLICATION_NAME} in ${env.ENVIRONMENT_NAME}."
                    )
                }
            }
        }

        stage('Execute Rollback') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'API_IS_Deployer',
                        usernameVariable: 'DEPLOYER_USER',
                        passwordVariable: 'DEPLOYER_PWD'
                    )
                ]) {

                    sh '''
                        CANDIDATE_NAME="${EPIC_NAME}_${ENVIRONMENT_NAME}"

                        chmod +x "${DEPLOYER_CMD}" || true

                        echo "Executing rollback..."
                        echo "Environment: ${ENVIRONMENT_NAME}"
                        echo "Project: ${EPIC_NAME}"
                        echo "Candidate: ${CANDIDATE_NAME}"

                        "${DEPLOYER_CMD}" --rollback \
                            -project "${EPIC_NAME}" \
                            -dc "${CANDIDATE_NAME}" \
                            -host "${DEPLOYER_HOST}" \
                            -port "${DEPLOYER_PORT}" \
                            -user "${DEPLOYER_USER}" \
                            -pwd "${DEPLOYER_PWD}"

                        echo "Rollback completed successfully."
                    '''
                }
            }
        }

        stage('Delete Deployment Candidate') {

            when {
                expression {
                    return params.DELETE_CANDIDATE_AFTER_ROLLBACK
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'API_IS_Deployer',
                        usernameVariable: 'DEPLOYER_USER',
                        passwordVariable: 'DEPLOYER_PWD'
                    )
                ]) {

                    sh '''
                        CANDIDATE_NAME="${EPIC_NAME}_${ENVIRONMENT_NAME}"

                        echo "Deleting deployment candidate..."
                        echo "Environment: ${ENVIRONMENT_NAME}"
                        echo "Project retained: ${EPIC_NAME}"
                        echo "Candidate deleted: ${CANDIDATE_NAME}"

                        chmod +x "${DEPLOYER_CMD}" || true

                        "${DEPLOYER_CMD}" --delete \
                            -project "${EPIC_NAME}" \
                            -dc "${CANDIDATE_NAME}" \
                            -host "${DEPLOYER_HOST}" \
                            -port "${DEPLOYER_PORT}" \
                            -user "${DEPLOYER_USER}" \
                            -pwd "${DEPLOYER_PWD}"

                        echo "Deployment candidate cleanup completed."
                        echo "Shared Deployer project was retained."
                    '''
                }
            }
        }
    }

    post {

        success {

            script {

                sendRollbackEmail(
                    'Success',
                    '#27ae60',
                    "Rollback has been completed successfully for ${env.APPLICATION_NAME} in ${env.ENVIRONMENT_NAME}."
                )
            }
        }

        failure {

            script {

                sendRollbackEmail(
                    'Failed',
                    '#c0392b',
                    "Rollback has failed for ${env.APPLICATION_NAME} in ${env.ENVIRONMENT_NAME}."
                )
            }
        }

        aborted {

            script {

                sendRollbackEmail(
                    'Aborted',
                    '#7f8c8d',
                    "Rollback was aborted for ${env.APPLICATION_NAME} in ${env.ENVIRONMENT_NAME}."
                )
            }
        }

        always {
            echo 'Rollback job finished.'
        }
    }
}


def sendRollbackEmail(status, color, message) {
    emailext(
        to: env.EMAIL_RECIPIENTS,
        subject: "${env.EMAIL_SUBJECT} ${params.EPIC_NAME} - ${status} - ${new Date().format('yyyy-MM-dd HH:mm:ss')}",
        recipientProviders: [[$class: 'DevelopersRecipientProvider']],
        mimeType: 'text/html',
        body: """\
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <style>
                    body { font-family: Arial, sans-serif; line-height: 1.6; color: #34495e; }
                    .container { width: 600px; margin: auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; }
                    h2 { color: #2c3e50; margin-top: 0; }
                    .details { padding: 10px; border: 1px solid #e0e0e0; border-radius: 6px; }
                    .details p { margin: 6px 0; }
                    .status { color: ${color}; font-weight: bold; }
                    .btn { display: inline-block; margin-top: 15px; padding: 8px 12px; color: #3498db; text-decoration: none; border: 1px solid #3498db; border-radius: 5px; }
                    .footer { margin-top: 20px; font-size: 12px; color: #7f8c8d; }
                </style>
            </head>

            <body>
                <div class="container">
                    <h2>TAWUNIYA - ${env.ENVIRONMENT_NAME} Rollback ${status}</h2>

                    <p>Dears,</p>
                    <p>${message}</p>

                    <div class="details">
                        <p><strong>Application:</strong> ${env.APPLICATION_NAME}</p>
                        <p><strong>Environment:</strong> ${env.ENVIRONMENT_NAME}</p>
                        <p><strong>EPIC / Project:</strong> <a href="https://sd.tawn.com/browse/${params.EPIC_NAME}">${params.EPIC_NAME}</a></p>
                        <p><strong>Deployment Candidate:</strong> ${params.EPIC_NAME}_${env.ENVIRONMENT_NAME}</p>
                        <p><strong>Rollback Scope:</strong> Latest retained ${env.ENVIRONMENT_NAME} deployment</p>
                        <p><strong>Jenkins Agent:</strong> ${env.NODE_NAME}</p>
                        <p><strong>Delete Candidate After Rollback:</strong> ${params.DELETE_CANDIDATE_AFTER_ROLLBACK}</p>
                        <p><strong>Shared Project Retained:</strong> Yes</p>
                        <p><strong>Approval Comment:</strong> ${env.APPROVER_COMMENT ?: 'N/A'}</p>
                        <p><strong>Status:</strong> <span class="status">${status}</span></p>
                        <p><strong>Rollback Date-Time:</strong> ${new Date().format('yyyy-MM-dd HH:mm:ss')}</p>
                    </div>

                    <a class="btn" href="${env.BUILD_URL}">View Jenkins Build</a>

                    <div class="footer">
                        <p>Thank you for your cooperation.</p>
                        <p><strong>Best regards,</strong><br>The DevOps Team</p>
                    </div>
                </div>
            </body>
            </html>
        """
    )
}