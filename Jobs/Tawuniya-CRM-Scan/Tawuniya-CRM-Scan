pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'BRANCH_NAME',
            choices: ['DEV', 'QC', 'UAT', 'PROD'],
            description: 'Select the branch to scan'
        )

        string(
            name: 'Project_Version',
            defaultValue: '1.0.0',
            description: 'Enter the version for this analysis'
        )
    }

    stages {
        stage('Set Build Name') {
            agent {
                label 'CRM-SQL-UAT'
            }

            steps {
                script {
                    currentBuild.displayName =
                        "#${BUILD_NUMBER}-${params.BRANCH_NAME}"
                }
            }
        }

        stage('Checkout SCM') {
            agent {
                label 'CRM-SQL-UAT'
            }

            steps {
                cleanWs(
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: true
                )

                script {
                    env.PATH =
                        "C:\\Program Files\\Git\\cmd;" +
                        "C:\\Program Files\\Git\\bin;" +
                        "${env.PATH}"

                    bat(
                        label: 'Check Git Version',
                        script: 'git --version'
                    )

                    bat(
                        label: 'Configure Git SSL',
                        script: 'git config --global http.sslVerify false'
                    )

                    git(
                        credentialsId: 'Admin_Bitbucket',
                        url: 'https://bitbucket.tawn.com/scm/mscrm/tawuniya-crm.git',
                        branch: "${params.BRANCH_NAME}"
                    )
                }
            }
        }

        stage('Restore + Build + Sonar Analysis') {
            agent {
                label 'CRM-SQL-UAT'
            }

            environment {
                SONAR_USER_HOME ='E:\\.sonar_cache'
                SONAR_MSBUILD ='E:\\$tools\\SonarScannerMSBuild\\SonarScanner.MSBuild.exe'
                MSBUILD_EXE ='C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\MSBuild\\Current\\Bin\\MSBuild.exe'
                SOLUTION_FILE ='Tawuniya.Crm.sln'
                NUGET_SOURCE ='https://nexus.tawuniya.com/repository/nuget-proxy/index.json'
                NUGET_CONFIG ="${WORKSPACE}\\NuGet.Jenkins.Config"
                NUGET_CERT_REVOCATION_MODE ='offline'
                JAVA_HOME ='E:\\jdk-21'
                PATH ="${JAVA_HOME}\\bin;${env.PATH}"
            }

            steps {
                script {
                    /*
                     * Create a job-specific NuGet v3 configuration.
                     *
                     * The clear element prevents MSBuild from using:
                     * - api.nuget.org
                     * - Visual Studio local package sources
                     *
                     * Only Tawuniya Nexus will be used.
                     */
                    writeFile(
                        file: 'NuGet.Jenkins.Config',
                        text: '''<?xml version="1.0" encoding="utf-8"?>
                                    <configuration>
                                      <packageSources>
                                        <clear />
                                        <add key="Tawuniya-Nexus"
                                             value="https://nexus.tawuniya.com/repository/nuget-proxy/index.json"
                                             protocolVersion="3" />
                                      </packageSources>
                                    
                                      <disabledPackageSources>
                                        <clear />
                                      </disabledPackageSources>
                                    </configuration>
                                '''
                    )

                    /*
                     * Restore packages before starting SonarQube.
                     *
                     * This prevents starting an incomplete SonarQube
                     * analysis if package restoration fails.
                     */
                    bat(
                        label: 'Restore Packages from Nexus',
                        script: """
                                    "%MSBUILD_EXE%" "%SOLUTION_FILE%" ^
                                    /t:Restore ^
                                    /p:RestorePackagesConfig=true ^
                                    /p:RestoreConfigFile="%NUGET_CONFIG%" ^
                                    /p:RestoreSources="%NUGET_SOURCE%" ^
                                    /p:RestoreDisableParallel=true ^
                                    /p:RestoreIgnoreFailedSources=false ^
                                    /p:Configuration=Release ^
                                    /m:1 ^
                                    /v:normal
                                """
                    )

                    withSonarQubeEnv('SonarQube') {
                        bat(
                            label: 'Start SonarQube Analysis',
                            script: """
                                        "%SONAR_MSBUILD%" begin ^
                                        /key:"Tawuniya-CRM" ^
                                        /name:"Tawuniya-CRM" ^
                                        /version:"${params.Project_Version}-${env.BUILD_NUMBER}" ^
                                        /d:sonar.branch.name="${params.BRANCH_NAME}" ^
                                        /d:sonar.sourceEncoding=UTF-8 ^
                                        /d:sonar.exclusions="**/.vs/**,**/bin/**,**/obj/**,**/packages/**,**/node_modules/**,**/TestResults/**,**/coverage/**,**/*.min.js,**/*.min.css,**/package-lock.json,Customer360/VeriTouch.C360.WebResources/statistics_webpages.html" ^
                                        /d:sonar.tsql.file.suffixes=.sql,.tsql ^
                                        /d:sonar.plsql.file.suffixes=.pks,.pkb ^
                                        /d:sonar.plsqlopen.file.suffixes=.pkg,.trg,.vw,.fnc,.prc ^
                                        /d:sonar.scanner.skip.ssl.verification=true ^
                                        /d:sonar.scanner.skipJreProvisioning=true
                                    """
                        )

                        bat(
                            label: 'Prepare CRM Assemblies',
                            script: """
                                        if not exist "..\\Assemblies" mkdir "..\\Assemblies"
                                        
                                        xcopy /Y "Assemblies\\*.dll" "..\\Assemblies\\"
                                        xcopy /Y "Assemblies\\*.xml" "..\\Assemblies\\"
                                        
                                        if not exist "BatchJobs\\Tawuniya.Crm.BatchJobs.CreateTicketsEvaluationInstances\\bin\\Debug" mkdir "BatchJobs\\Tawuniya.Crm.BatchJobs.CreateTicketsEvaluationInstances\\bin\\Debug"
                                        
                                        copy /Y "packages\\Serilog.4.2.0\\lib\\net462\\Serilog.dll" "BatchJobs\\Tawuniya.Crm.BatchJobs.CreateTicketsEvaluationInstances\\bin\\Debug\\"
                                        
                                        copy /Y "packages\\Serilog.Sinks.Console.6.0.0\\lib\\net462\\Serilog.Sinks.Console.dll" "BatchJobs\\Tawuniya.Crm.BatchJobs.CreateTicketsEvaluationInstances\\bin\\Debug\\"
                                        
                                        copy /Y "packages\\Serilog.Sinks.File.7.0.0\\lib\\net462\\Serilog.Sinks.File.dll" "BatchJobs\\Tawuniya.Crm.BatchJobs.CreateTicketsEvaluationInstances\\bin\\Debug\\"
                                    """
                        )

                        bat(
                            label: 'Rebuild CRM Solution',
                            script: """
                                        "%MSBUILD_EXE%" "%SOLUTION_FILE%" ^
                                        /t:Rebuild ^
                                        /p:Configuration=Release ^
                                        /p:RestorePackages=false ^
                                        /m:1
                                    """
                        )

                        bat(
                            label: 'Complete SonarQube Analysis',
                            script: """
                                        "%SONAR_MSBUILD%" end
                                    """
                        )
                    }
                }
            }
        }

        stage('Quality Gate') {
            agent {
                label 'SonarQube'
            }

            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            echo "Scan completed for ${params.BRANCH_NAME}"
        }
    }
}